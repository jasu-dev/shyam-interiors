Options -Indexes
RewriteEngine On

# -----------------------------------------------
# 1. Force HTTPS + non-WWW
# -----------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://stinteriors.in%{REQUEST_URI} [R=301,L]

# -----------------------------------------------
# Redirect /index.php → /
# -----------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# -----------------------------------------------
# Redirect /index → /
# -----------------------------------------------
RewriteRule ^index/?$ / [R=301,L,NC]

# -----------------------------------------------
# Remove .php from URL
# -----------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# -----------------------------------------------
# Skip excluded paths
# -----------------------------------------------
RewriteCond %{REQUEST_URI} ^/(core|config) [NC]
RewriteRule ^ - [L]

# -----------------------------------------------
# Internal rewrite (clean URL → .php)
# -----------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [L]